# SkyFlip environment (copy to .env — never commit secrets)
# You set ADMIN_TOKEN / Neon / Blob values yourself in Vercel and local .env.

# --- CORS (no "*"; comma-separated allowlist) ---
# Local + production. Replace YOUR-PROJECT after you create the Vercel project.
# Preview URLs: only add if you can restrict them to your project (e.g. https://*-YOUR-PROJECT.vercel.app).
# SKYFLIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-PROJECT.vercel.app

# --- Database ---
# Local default: SQLite (no DATABASE_URL needed).
# SKYFLIP_OBSERVATIONS_DB=/absolute/path/observations.sqlite3
# Production (Neon via Vercel): set DATABASE_URL; app selects Postgres when present.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# SKYFLIP_STORAGE_BACKEND=sqlite   # local
# SKYFLIP_STORAGE_BACKEND=postgres # Neon

# --- File storage ---
# Local default: disk under .cache/observations/
# SKYFLIP_OBSERVATION_STORAGE=/absolute/path/observation_blobs
# Production: Vercel Blob (set in Vercel dashboard; do not commit the token)
# BLOB_READ_WRITE_TOKEN=
# SKYFLIP_BLOB_BACKEND=local   # local
# SKYFLIP_BLOB_BACKEND=vercel  # Vercel Blob

# --- Admin (token-only; you generate this yourself — never commit the real value) ---
# SKYFLIP_ADMIN_TOKEN=

# Optional email alert on new submission (failure must never fail the submit)
# SKYFLIP_SMTP_HOST=
# SKYFLIP_SMTP_PORT=587
# SKYFLIP_SMTP_USER=
# SKYFLIP_SMTP_PASSWORD=
# SKYFLIP_ALERT_TO=
# Or Resend:
# SKYFLIP_RESEND_API_KEY=
# SKYFLIP_ALERT_TO=

# Optional CAPTCHA (off by default)
# SKYFLIP_TURNSTILE_SECRET=
# SKYFLIP_HCAPTCHA_SECRET=

# Rate limit: submissions per hour per salted client key
# SKYFLIP_OBS_RATE_LIMIT=5

# Max upload bytes per submission (default 20_000_000)
# SKYFLIP_OBS_MAX_BYTES=20000000
